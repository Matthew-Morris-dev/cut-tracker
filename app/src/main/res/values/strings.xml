    <string name="back">Back</string>
    <string name="rationale_title">How Cut Tracker uses your health data</string>
    <string name="rationale_reads_title">What it reads</string>
    <string name="rationale_reads_body">Your weight, body fat and lean body mass, so weigh-ins from Renpho Health or any other app show on the Progress screen.</string>
    <string name="rationale_writes_title">What it writes</string>
    <string name="rationale_writes_body">The food you log, with its name, calories and protein, so other health apps can see what you ate.</string>
    <string name="rationale_where_title">Where it goes</string>
    <string name="rationale_where_body">Everything stays on this phone. Cut Tracker has no account and no server, and it doesn\'t send your data anywhere.</string>
    <string name="rationale_change_title">Changing your mind</string>
    <string name="rationale_change_body">You can turn any of this off in Health Connect at any time. Weigh-ins already brought in stay in Cut Tracker.</string>

